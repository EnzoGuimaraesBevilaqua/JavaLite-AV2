main() {
    int idade = 20;
    int contador = 0;
    boolean ativo = true;

    if (idade >= 18) {
        print(idade);
    } else {
        print(contador);
    }

    while (contador < 5) {
        contador = contador + 1;
        print(contador);
    }

    if (ativo && contador == 5) {
        print(idade + contador);
    } else {
        print(0);
    }
}